# =============================================================
# NexBank Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control!
# =============================================================

# ─── PostgreSQL ───────────────────────────────────────────
POSTGRES_URL=jdbc:postgresql://localhost:5432/nexbank
POSTGRES_USERNAME=nexbank_user
POSTGRES_PASSWORD=your_strong_password_here

# ─── Redis ────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ─── JWT ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=replace_with_a_very_long_random_base64_string_at_least_64_chars
JWT_REFRESH_SECRET=replace_with_another_very_long_random_base64_string_64_chars

# ─── SendGrid ─────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@nexbank.com

# ─── Cloudinary ───────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Razorpay Sandbox ─────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
